# 复制为 backend/.env 后填写；聊天与向量模型分别配置。
# OpenAI 兼容服务地址，程序会追加 /chat/completions
PK_LLM_BASE_URL=https://api.openai.com/v1
# 模型名称，需支持工具调用（tool calling）
PK_LLM_MODEL=
# 模型密钥，只在后端使用，不要提交到 Git
PK_LLM_API_KEY=

# cosine：旧词频余弦；bm25：关键词；vector：向量；hybrid：BM25 + 向量 RRF
PK_RETRIEVER=hybrid
# 服务 API 根地址（例如 https://your-provider.example/v1），程序追加 /embeddings
PK_EMBEDDING_BASE_URL=
PK_EMBEDDING_MODEL=bge-m3
# 本地免认证服务可留空；远程服务按提供商要求填写
PK_EMBEDDING_API_KEY=
# 维度、超时、批大小、revision 等均有默认值，见 docs/backend.md

# 结构化解析（PDF/DOCX 使用 Docling，首次解析需联网下载模型，或先运行
# uv run --directory backend python -m app.parsers.prefetch）
# 单个文档解析超时（秒），超时会终止解析进程
PK_PARSE_TIMEOUT=1800
# 分块 token 上限（按 BGE-M3 分词器计数）；离线时可把分词器设为本地目录
PK_CHUNK_MAX_TOKENS=512
PK_CHUNK_TOKENIZER=BAAI/bge-m3
# Docling 模型本地目录（离线部署）；留空使用 Hugging Face 缓存
PK_DOCLING_ARTIFACTS_PATH=
# auto / cpu / mps / cuda
PK_DOCLING_DEVICE=auto
# 增强模式的 OCR 引擎：rapidocr / easyocr / tesseract / ocrmac
PK_DOCLING_OCR_ENGINE=rapidocr
