PK_DATA_DIR=data
# 请求未携带 X-User-Id 请求头时使用的用户
PK_DEFAULT_USER_ID=demo
# extractive: 本地原文摘录；openai: 调用兼容 Chat Completions 的模型服务
PK_ANSWER_MODE=extractive
PK_LLM_BASE_URL=https://api.openai.com/v1
PK_LLM_MODEL=
PK_LLM_API_KEY=
PK_LLM_TIMEOUT=45
PK_MAX_UPLOAD_BYTES=10485760
PK_LOG_LEVEL=INFO
# 模型服务不支持流式工具调用时设为 false
PK_LLM_STREAM=true
PK_AGENT_MAX_STEPS=6
PK_TOOL_TIMEOUT=15
PK_CONTEXT_BUDGET_CHARS=24000
# cosine | bm25 | hybrid
PK_RETRIEVER=cosine
# MCP stdio Server 以该用户身份访问知识库
PK_MCP_USER_ID=demo
